# routeOS · RouterOS Variables
# Edit these values before importing the other scripts.

:global syntagHost "192.168.1.100"
:global syntagESP32Port "4003"
:global mqttBrokerPort "1883"

:global deviceId "routeros-core-zone-a"
:global deviceName "RouterOS Core Switch"
:global deviceZone "Zone-A"
:global deviceMachine "core-switch"
:global deviceFirmware "RouterOS 7.15.3"
:global deviceInterface "ether1"

:log info "routeOS: variables loaded"
