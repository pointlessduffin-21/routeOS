# Copy to s3-4g/sdkconfig.credentials and fill in. The real file is gitignored: the auth key joins a tailnet.
#
# CMakeLists.txt appends this file to SDKCONFIG_DEFAULTS when it exists, so the values land in sdkconfig at
# configure time. Without it the firmware still builds and boots; it logs "no Tailscale auth key - not joining the
# tailnet" and serves the display on the local link only.
#
# Use a tagged, reusable key from the Tailscale admin console (Auth keys -> Generate, "Reusable").
CONFIG_ML_TAILSCALE_AUTH_KEY="tskey-auth-REPLACE-ME"
CONFIG_ML_DEVICE_NAME="routeos-4g"
