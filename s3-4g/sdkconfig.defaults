CONFIG_IDF_TARGET="esp32s3"

# Flash: 16 MB on this board (esptool reads ef:4018).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# PSRAM: 2 MB quad, in-package (esptool: "Embedded PSRAM 2MB (AP_3v3)"). Auto-detect the type so a re-spin with
# octal parts still boots.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# lwIP: sockets for the VPN + PPP for the SIM7670X data path.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION=n

# Noise (control plane) and TLS (DERP + coordination) need ChaCha20-Poly1305 and HKDF.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Console stays on UART0 for now; move it to USB-Serial-JTAG if the modem turns out to use GPIO43/44.
CONFIG_ESP_CONSOLE_UART_NUM=0

# --- microlink (Tailscale) ---
CONFIG_ML_ENABLE_CELLULAR=y
CONFIG_ML_ENABLE_CONFIG_HTTPD=n
# 2 MB of PSRAM total: the stock 512 KB H2 + 512 KB JSON buffers cannot both be allocated. 128 KB each covers a
# tailnet of roughly 50 peers, which is far more than this node needs.
CONFIG_ML_H2_BUFFER_SIZE_KB=128
CONFIG_ML_JSON_BUFFER_SIZE_KB=128
CONFIG_ML_MAX_PEERS=16
CONFIG_ML_NVS_MAX_PEERS=16
# The tailnet has more peers than this node can hold (25 vs 8), and a peer that is not in the table cannot complete a
# WireGuard handshake - so inbound connections from anywhere else are dropped. CW-LAPTOP is the machine that views the
# screen, so it gets reserved slot.
CONFIG_ML_PRIORITY_PEER_IP="100.96.133.118"

# --- SIM7670G on the Waveshare ESP32-S3-A-SIM7670X-4G V2.0 ---
# ESP TX GPIO18 -> modem RX, ESP RX GPIO17 <- modem TX. GPIO17/18 only reach the modem when the "4G" DIP is ON.
CONFIG_ML_CELLULAR_TX_PIN=18
CONFIG_ML_CELLULAR_RX_PIN=17
CONFIG_ML_CELLULAR_APN="internet.globe.com.ph"
# WiFi-primary with cellular fallback; the net switch retries WiFi for 6 s then brings the modem up.
CONFIG_ML_ENABLE_NET_SWITCH=y
CONFIG_ML_NET_SWITCH_WIFI_TIMEOUT_MS=6000
CONFIG_ML_NET_SWITCH_FAILBACK_MS=0

# --- LVGL (Orbit UI) ---
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_API_MAP_V8=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_HTTPD_WS_SUPPORT=y

