# S3-4G (Waveshare ESP32-S3-A-SIM7670X-4G) - configuration known to build and run.
#
# This file is what makes a fresh clone reproduce the board. It was produced with `idf.py save-defconfig` from a
# board that works, then annotated. Only values that differ from the ESP-IDF 5.5.2 defaults are strictly needed, but
# several defaults are pinned here on purpose: an IDF upgrade must not quietly change them.
#
# Secrets are NOT in this file:
#   CONFIG_ML_TAILSCALE_AUTH_KEY  -> sdkconfig.credentials (gitignored, copy sdkconfig.credentials.example)
#   HMI_WIFI_SSID / PASSWORD      -> main/wifi_secrets.h   (gitignored, copy main/wifi_secrets.h.example)
# Without either, the firmware still builds and boots: it runs cellular-only and logs "no Tailscale auth key".
#
# Build: idf.py -C s3-4g build      (CMakeLists.txt adds sdkconfig.credentials when it exists)
# Flash: idf.py -C s3-4g -p <PORT> -b 460800 flash monitor

CONFIG_IDF_TARGET="esp32s3"

# --- Flash: 16 MB on this board (esptool reports the real size; older docs say 8 MB and that is wrong) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# --- PSRAM: 2 MB quad, in-package. Auto-detect the type so a re-spin with octal parts still boots. ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_FREERTOS_HZ=1000

# --- Console on UART0: the modem does not use GPIO43/44 on this board, so UART0 stays where the CH343 sees it. ---
CONFIG_ESP_CONSOLE_UART_NUM=0

# --- lwIP: sockets for the VPN, PPP for the SIM7670X data path, and windows wide enough that a 480x800 RVDP frame
# does not collapse into a trickle at 70 ms round trip. ---
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION=n

# --- mbedTLS: Noise (control plane) needs ChaCha20-Poly1305 and HKDF; the DERP and coordination clients need TLS
# with a CA bundle. ---
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# --- HTTP server: RVDP is a WebSocket, so this is not optional. Without it the board serves no display at all. ---
CONFIG_HTTPD_WS_SUPPORT=y

# --- microlink (Tailscale) ---
CONFIG_ML_ENABLE_CELLULAR=y
CONFIG_ML_ENABLE_CONFIG_HTTPD=n
# 2 MB of PSRAM total: the stock 512 KB H2 + 512 KB JSON buffers cannot both be allocated. 128 KB each covers a
# tailnet of roughly 50 peers.
CONFIG_ML_H2_BUFFER_SIZE_KB=128
CONFIG_ML_JSON_BUFFER_SIZE_KB=128
# The tailnet has more peers than the WireGuard table has slots, and a peer without a slot cannot complete a
# handshake, so inbound connections from it are dropped. These keep room for the peers that actually connect.
CONFIG_ML_MAX_PEERS=16
CONFIG_ML_NVS_MAX_PEERS=16
CONFIG_ML_PRIORITY_PEER_IP="100.96.133.118"

# --- SIM7670X on the Waveshare ESP32-S3-A-SIM7670X-4G V2.0 ---
# ESP TX GPIO18 -> modem RX, ESP RX GPIO17 <- modem TX. GPIO17/18 only reach the modem when DIP switch 3 ("4G") is ON.
# Modem power is a MOSFET on GPIO21, pulsed low for 400 ms at boot.
CONFIG_ML_CELLULAR_TX_PIN=18
CONFIG_ML_CELLULAR_RX_PIN=17
CONFIG_ML_CELLULAR_APN="internet.globe.com.ph"
# Wi-Fi primary, cellular fallback: try Wi-Fi for 6 s, then bring the modem up. Failback is off on purpose - the
# Wi-Fi at home is 5 GHz in part and the S3 radio cannot see it, so failback would flap between the two.
CONFIG_ML_ENABLE_NET_SWITCH=y
CONFIG_ML_NET_SWITCH_WIFI_TIMEOUT_MS=6000
CONFIG_ML_NET_SWITCH_FAILBACK_MS=0

# --- LVGL, the Orbit UI ---
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
