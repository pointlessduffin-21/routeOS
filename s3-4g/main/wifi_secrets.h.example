// Copy to s3-4g/main/wifi_secrets.h and fill in. The real file is gitignored because it holds a password.
//
// The board tries Wi-Fi first and falls back to cellular after CONFIG_ML_NET_SWITCH_WIFI_TIMEOUT_MS. The ESP32-S3
// radio is 2.4 GHz only: a 5 GHz SSID will never appear in a scan, so choose the 2.4 GHz network.
//
// Leaving the file out entirely is fine: the build logs a warning and runs cellular-only.
#pragma once

#define HMI_WIFI_SSID "your-2.4ghz-ssid"
#define HMI_WIFI_PASSWORD "your-password"
