// Copy to p4/hmi/main/wifi_secrets.h and fill in. The real file is gitignored because it holds a password.
//
// This is the P4's own Wi-Fi (the ESP32-C6 radio hosted over SDIO), not the S3-4G's. The radio is 2.4 GHz only.
// Leaving the file out is fine: the build succeeds and the board runs without Wi-Fi.
#pragma once

#define HMI_WIFI_SSID "your-2.4ghz-ssid"
#define HMI_WIFI_PASSWORD "your-password"
